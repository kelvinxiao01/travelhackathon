LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Used only by the Python agent worker for its direct Gemini Live connection.
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_VOICE=Puck

# Backend-only trip context and itinerary-edit bridge. Use the same secret in
# plana-be/.env; do not expose either value to the browser.
PLANA_BACKEND_URL=http://127.0.0.1:8000
PLANA_VOICE_AGENT_SECRET=
