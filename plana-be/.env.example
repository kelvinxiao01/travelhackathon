# Supabase credentials stay in this backend; never copy them to the browser or
# the LiveKit worker. SUPABASE_SK is supported for existing deployments.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Use the exact same value in plana-voice/.env.local so the LiveKit worker can
# make authenticated, server-to-server trip-context and itinerary-edit requests.
PLANA_VOICE_AGENT_SECRET=
